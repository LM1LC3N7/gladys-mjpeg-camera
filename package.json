{
  "name": "gladys-mjpeg-camera",
  "version": "0.1.0",
  "private": true,
  "description": "MJPEG and snapshot IP cameras for Gladys Assistant (ESP32-CAM, older IP cameras, webcams): camera images in Gladys without RTSP, on the local network.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-mjpeg-camera.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0"
}
